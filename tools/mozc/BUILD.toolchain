load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":ohos_toolchain.bzl", "ohos_config")
package(default_visibility = ["//visibility:public"])
filegroup(name = "empty")
ohos_config(name = "config")
cc_toolchain(name = "cc", toolchain_identifier = "ohos-arm64", toolchain_config = ":config", all_files = ":empty", ar_files = ":empty", as_files = ":empty", compiler_files = ":empty", dwp_files = ":empty", linker_files = ":empty", objcopy_files = ":empty", strip_files = ":empty", supports_param_files = 1)
platform(name = "arm64", constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:linux"])
toolchain(name = "toolchain", toolchain = ":cc", toolchain_type = "@bazel_tools//tools/cpp:toolchain_type", exec_compatible_with = ["@platforms//os:osx", "@platforms//cpu:aarch64"], target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:aarch64"])
